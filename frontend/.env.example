# ReWise AI Frontend Environment Configuration

# Backend API URL (Default local development)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Google Maps API Key for Pan-India Service & Recycler Locator
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Supabase (Optional)
VITE_SUPABASE_KEY=your_supabase_key_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_URL=your_supabase_url_here

# Apify Web Intelligence (Optional)
VITE_APIFY_API_KEY=your_apify_api_key_here
