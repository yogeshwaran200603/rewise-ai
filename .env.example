# ==============================================================================
# ReWise AI - Environment Configuration Example
# ==============================================================================

# Application
PROJECT_NAME="ReWise AI"
ENVIRONMENT="development"

# Database (Default: SQLite local zero-config, or connect Supabase PostgreSQL)
# Example Supabase: postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="sqlite:///./rewise.db"

# Supabase Server-Side Configuration (NEVER expose to frontend!)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Google Gemini Multimodal AI API
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-flash-latest"
AI_TIMEOUT_SECONDS=25

# Google Maps API (Geocoding & Tiles)
MAPS_API_KEY="your-google-maps-api-key"

# Apify API Token (Server-Side Only - NEVER expose to frontend!)
APIFY_API_TOKEN="your-apify-api-token"

# Optional: Apify Actor IDs for Automated Data Sync
APIFY_DEVICE_ACTOR=""
APIFY_PRICE_ACTOR=""
APIFY_RESALE_ACTOR=""
APIFY_SERVICE_CENTER_ACTOR=""
APIFY_SEARCH_ACTOR=""

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "*"]
